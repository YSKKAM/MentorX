# ============================================
# AI Classroom Platform - Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# ---------- Database ----------
DATABASE_URL=postgresql://classroom_user:classroom_pass@localhost:5432/classroom_db

# ---------- Auth ----------
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=24h

# ---------- Server ----------
SERVER_PORT=3001
CLIENT_URL=http://localhost:3000

# ---------- Encryption (for AI API keys) ----------
ENCRYPTION_KEY=your-32-byte-hex-encryption-key-here

# ---------- AI Providers (for testing only, users provide their own) ----------
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AI...
