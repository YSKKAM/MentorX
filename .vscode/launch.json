{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run AI Classroom Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/extensions/vscode-classroom"
      ],
      "outFiles": [
        "${workspaceFolder}/extensions/vscode-classroom/dist/**/*.js"
      ]
    }
  ]
}
